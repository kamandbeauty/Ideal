extends RefCounted
func run(t: TestContext) -> void:
	var controller := ArtilleryController.new()
	controller.data = load("res://resources/weapons/kestrel.tres")
	t.tree.root.add_child(controller)
	var ammo: AmmunitionData = load("res://resources/ammunition/he.tres")
	t.check(controller.fire(ammo), "Ready gun fires")
	t.check(not controller.fire(ammo), "Cannot fire before reload")
	t.check(controller.begin_reload(3.0), "Reload starts")
	t.check(not controller.begin_reload(3.0), "No duplicate reload")
	controller.tick(1.5)
	t.near(controller.reload_remaining, 1.5, 0.001, "Reload midpoint")
	t.check(not controller.can_fire(), "Cannot fire during reload")
	controller.tick(1.5)
	t.check(controller.can_fire(), "Ready at exact reload duration")
	controller.adjust(1000, 1000)
	t.near(controller.yaw_degrees, 52, 0.001, "Traverse upper clamp")
	t.near(controller.elevation_degrees, 72, 0.001, "Elevation upper clamp")
	controller.adjust(-2000, -2000)
	t.near(controller.yaw_degrees, -52, 0.001, "Traverse lower clamp")
	t.near(controller.elevation_degrees, 4, 0.001, "Elevation lower clamp")
	controller.free()
	var he: AmmunitionData = load("res://resources/ammunition/he.tres")
	var ap: AmmunitionData = load("res://resources/ammunition/ap.tres")
	var loadout := WeaponLoadout.new(load("res://resources/weapons/kestrel.tres"), [he, ap], {"he": 2, "ap": 1}, {})
	t.equal(loadout.total_remaining(), 3, "Mission ammunition supply")
	t.check(loadout.consume() != null and loadout.consume() != null, "Ammo consumed")
	t.check(loadout.consume() == null, "Empty ammunition cannot fire")
	t.check(not loadout.select("unknown"), "Incompatible ammo rejected")
	t.check(loadout.select("ap"), "Compatible ammo selected")
	t.check(loadout.consume() != null, "Second ammo type usable")
	t.equal(loadout.total_remaining(), 0, "Inventory exhausted")
