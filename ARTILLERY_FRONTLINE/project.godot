; ARTILLERY FRONTLINE — original offline artillery game.
config_version=5

[application]
config/name="ARTILLERY FRONTLINE"
config/description="Original offline 3D artillery combat · Sable Ridge vertical slice"
config/version="0.1.0"
run/main_scene="res://scenes/core/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="ArtilleryFrontline"
config/icon="res://assets/textures/icon.svg"
boot_splash/bg_color=Color(0.035, 0.047, 0.043, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/textures/icon.png"

[autoload]
Events="*res://scripts/core/event_bus.gd"
Profile="*res://scripts/progression/profile.gd"
Sound="*res://scripts/audio/audio_manager.gd"
Graphics="*res://scripts/graphics/graphics_manager.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=810
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
rendering_device/driver.android="vulkan"
gl_compatibility/driver.android="opengl3"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.52, 0.57, 0.55, 1)
scaling_3d/mode=0
scaling_3d/scale=1.0

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=9.81

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[audio]
driver/enable_input=false

[filesystem]
import/blender/enabled=false

[layer_names]
3d_physics/layer_1="Terrain and structures"
3d_physics/layer_2="Enemy targets"
3d_physics/layer_3="Destructible cover"

[debug]
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_call_argument=0
