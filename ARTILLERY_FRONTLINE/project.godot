; LAST WALL: Zombie Siege — first-person wall defence shooter.
config_version=5

[application]

config/name="LAST WALL: Zombie Siege"
config/description="Hold the last wall. A first-person heavy-weapon stand against the horde."
config/version="0.6.0"
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/use_custom_user_dir=true
config/custom_user_dir_name="LastWall"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.04, 0.04, 0.045, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/textures/icon.png"
config/icon="res://assets/textures/icon.png"

[autoload]

Events="*res://scripts/core/event_bus.gd"
Profile="*res://scripts/save/profile.gd"
Sound="*res://scripts/audio/audio_manager.gd"
Graphics="*res://scripts/graphics/graphics_manager.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=810
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
rendering_device/driver.android="vulkan"
gl_compatibility/driver.android="opengl3"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.3, 0.27, 0.25, 1)
scaling_3d/mode=0
scaling_3d/scale=1.0

[internationalization]

locale/fallback="en"

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="GodotPhysics3D"
3d/default_gravity=9.81

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[audio]

driver/enable_input=false

[filesystem]

import/blender/enabled=false

[layer_names]

3d_physics/layer_1="World geometry"
3d_physics/layer_2="Zombie body"
3d_physics/layer_3="Zombie head"
3d_physics/layer_4="Gate and wall patch"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_call_argument=0
