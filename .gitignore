# Python bytecode from tools/
__pycache__/
*.pyc

# Composer (dev tooling only; the plugin ships no runtime dependencies)
/vendor/
composer.lock

# phpcs output
phpcs-report.xml
.phpcs-cache

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp

# Generated by tools/db-audit/render_schema.py
schema.sql

# Build output. The release ZIP is committed deliberately so it has a
# stable download URL: GitHub's release-asset endpoint (uploads.github.com)
# is not reachable from the build environment.
/dist/*
!/dist/custom-product-designer-*.zip

# Debug renders emitted by tools/generate_*_model.py
tools/*.ppm
tools/manifest.json

# Source model drops (the processed copy lives in the plugin assets)
/basic_t-shirt.glb
