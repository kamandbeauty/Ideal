# Node / skills CLI
node_modules/
.npm/

# Python validator
.venv/
__pycache__/
*.pyc

# Generated motion graphics (keep only editable sources and briefs)
out/
motion/*/frames/
motion/*/audio/vo-timed/
motion/*/*.mp4
motion/*/*.webm
motion/*/*.mov
motion/*/*.gif

# Deliverable videos are kept (not generated intermediates)
!motion/kamand-eyebrow-gel/exports/*.mp4
!motion/kamand-eye/exports/*.mp4
!motion/kamand-paper/exports/*.mp4
!motion/kamand-vox/exports/*.mp4

# THE ODD FILE: VO intermediates are regenerated by `npm run odd-file:audio`
motion/odd-file/audio/vo/trim/
motion/odd-file/audio/impact.wav

# Vendored TTS model weights are large and fetched separately
third_party/persian_tts/model/*
!third_party/persian_tts/model/README.md
third_party/persian_tts/output/

