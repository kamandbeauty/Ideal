# Node / skills CLI
node_modules/
.npm/

# Python validator
.venv/
__pycache__/
*.pyc

# Generated motion graphics (keep only editable sources and briefs)
out/
motion/*/frames/
motion/*/audio/vo-timed/
motion/*/*.mp4
motion/*/*.webm
motion/*/*.mov
motion/*/*.gif

# Deliverable videos are kept (not generated intermediates)
!motion/kamand-eyebrow-gel/exports/*.mp4
!motion/kamand-eye/exports/*.mp4
!motion/kamand-paper/exports/*.mp4
!motion/kamand-vox/exports/*.mp4

# Vendored TTS model weights are large and fetched separately
third_party/persian_tts/model/*
!third_party/persian_tts/model/README.md
third_party/persian_tts/output/

# OS
.DS_Store
Thumbs.db

# painted-story uploads: the voice and the reference clip stay local.
# Only a small reference (under ~50 MB) should ever be committed.
motion/painted-story/inputs/**/*.wav
motion/painted-story/inputs/**/*.mp3
motion/painted-story/inputs/**/*.m4a
motion/painted-story/inputs/**/*.mov
motion/painted-story/inputs/**/*.mkv
motion/painted-story/exports/*.mp4
motion/painted-story/exports/*.mov
motion/painted-story/exports/*.webm
