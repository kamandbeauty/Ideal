; Engine configuration file.
; Docs: https://docs.godotengine.org/en/latest/classes/class_projectsettings.html

config_version=5

[application]

config/name="Roadstop Tycoon"
config/description="Roadstop Tycoon — a hybrid idle tycoon of roadside towns for Android."
config/version="0.3.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.051, 0.078, 1)
boot_splash/show_image=false

[autoload]

App="*res://scripts/core/app.gd"
Sound="*res://scripts/core/sound.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/energy_saving/keep_screen_on=true

[gui]

theme/default_font_multichannel_signed_distance_field=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.051, 0.078, 1)
anti_aliasing/quality/msaa_3d=0
textures/default_filters/anisotropic_filtering_level=1
