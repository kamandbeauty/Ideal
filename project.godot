; Engine configuration file.
; Docs: https://docs.godotengine.org/en/latest/classes/class_projectsettings.html

config_version=5

[application]

config/name="Roadside Empire: Idle Tycoon"
config/description="Roadside Empire: Idle Tycoon — Build your desert gas station into a full roadside empire!"
config/version="1.41.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/icon.png"
boot_splash/bg_color=Color(0.92, 0.74, 0.46, 1)
boot_splash/show_image=false

[autoload]

App="*res://scripts/core/app.gd"
Sound="*res://scripts/core/sound.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[gui]

theme/default_font_multichannel_signed_distance_field=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.92, 0.74, 0.46, 1)
anti_aliasing/quality/msaa_3d=0
textures/default_filters/anisotropic_filtering_level=2
textures/vram_compression/import_etc2_astc=true
