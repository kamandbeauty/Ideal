class_name SoundDirector
extends Node
## The game's sound: one music player, a small pool of cue players, and the two switches from the save.
##
## The Unity project shipped no audio, so this is written from nothing — the cues in
## `assets/audio/` are generated by `tools/make_audio.py` from sine partials and shaped noise, not
## sampled from anywhere.
##
## It is reached through a static instance rather than a Godot autoload on purpose: the headless test
## suites run a bare SceneTree with no autoloads, and a missing singleton would turn every match into an
## error there. `play()` simply does nothing when no director exists.

const MUSIC_PATH := "res://assets/audio/music_palace.wav"
const CUE_PATHS := {
	"tap": "res://assets/audio/ui_tap.wav",
	"swap": "res://assets/audio/swap.wav",
	"match": "res://assets/audio/match.wav",
	"cascade": "res://assets/audio/cascade.wav",
	"power": "res://assets/audio/power_up.wav",
	"reject": "res://assets/audio/reject.wav",
	"reward": "res://assets/audio/reward.wav",
	"win": "res://assets/audio/win.wav",
	"lose": "res://assets/audio/lose.wav",
	# The event cues: a clear, an obstacle taking a hit, a fresh power-up and a combo chain.
	"clear": "res://assets/audio/clear.wav",
	"obstacle": "res://assets/audio/obstacle.wav",
	"combo": "res://assets/audio/combo.wav",
	"power_create": "res://assets/audio/powerup_create.wav",
}

const POOL_SIZE := 6
const MUSIC_GAIN_DB := -14.0
const CUE_GAIN_DB := -6.0

static var instance: SoundDirector

var sfx_enabled := true
var music_enabled := true

var _players: Array[AudioStreamPlayer] = []
var _next_player := 0
var _music: AudioStreamPlayer
var _cues: Dictionary = {}

func _ready() -> void:
	instance = self
	for key in CUE_PATHS:
		var stream := load(CUE_PATHS[key]) as AudioStream
		_cues[key] = stream

	for index in range(POOL_SIZE):
		var player := AudioStreamPlayer.new()
		player.name = "cue_%d" % index
		player.volume_db = CUE_GAIN_DB
		add_child(player)
		_players.append(player)

	_music = AudioStreamPlayer.new()
	_music.name = "music"
	_music.volume_db = MUSIC_GAIN_DB
	var music_stream := load(MUSIC_PATH) as AudioStreamWAV
	if music_stream != null:
		music_stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
		music_stream.loop_begin = 0
		music_stream.loop_end = int(music_stream.get_length() * music_stream.mix_rate)
		_music.stream = music_stream
	add_child(_music)

func _exit_tree() -> void:
	if instance == self:
		instance = null

## Reads the two switches out of a save; safe to call before `_ready`.
func apply_settings(save: SaveData) -> void:
	if save == null:
		return
	sfx_enabled = save.sfx_on
	music_enabled = save.music_on
	if music_enabled:
		start_music()
	else:
		stop_music()

func start_music() -> void:
	if not music_enabled or _music == null or _music.stream == null:
		return
	if not _music.playing:
		_music.play()

func stop_music() -> void:
	if _music != null and _music.playing:
		_music.stop()

## Plays a cue by name. Unknown names are ignored rather than raised: a typo in a screen must not be
## able to crash a level.
static func play(cue: String, pitch: float = 1.0, volume_db: float = 0.0) -> void:
	if instance != null:
		instance.play_cue(cue, pitch, volume_db)

func play_cue(cue: String, pitch: float = 1.0, volume_db: float = 0.0) -> void:
	if not sfx_enabled or _players.is_empty():
		return
	var stream: AudioStream = _cues.get(cue, null)
	if stream == null:
		return
	var player := _players[_next_player]
	_next_player = (_next_player + 1) % _players.size()
	player.stream = stream
	player.pitch_scale = clampf(pitch, 0.5, 2.0)
	player.volume_db = CUE_GAIN_DB + volume_db
	player.play()

## True when the cue file really is loaded — the settings screen and the tests both ask.
func has_cue(cue: String) -> bool:
	return _cues.has(cue)

static func cue_names() -> Array:
	return CUE_PATHS.keys()
