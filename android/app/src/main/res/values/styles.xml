<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the Flutter engine boots: matches the dark app background
         so there is no white flash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">#0B0B12</item>
        <item name="android:navigationBarColor">#0B0B12</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">#0B0B12</item>
    </style>
</resources>
