 "captions": [
  {
   "start": 0.18,
   "end": 1.5,
   "text": "یه زن جوون"
  },
  {
   "start": 1.96,
   "end": 4.24,
   "text": "با یه نوزاد توی بغلش"
  },
  {
   "start": 4.55,
   "end": 6.27,
   "text": "از خونه بیرون زد"
  },
  {
   "start": 6.44,
   "end": 7.81,
   "text": "و دیگه برنگشت"
  },
  {
   "start": 8.38,
   "end": 10.19,
   "text": "نه پول درست‌وحسابی داشت"
  },
  {
   "start": 10.84,
   "end": 12.33,
   "text": "نه کار"
  },
  {
   "start": 12.33,
   "end": 13.35,
   "text": "نه حتی می‌دونست"
  },
  {
   "start": 13.35,
   "end": 14.94,
   "text": "قراره شب کجا بمونه"
  },
  {
   "start": 15.49,
   "end": 17.6,
   "text": "اون از یه رابطه‌ی خشونت‌آمیز"
  },
  {
   "start": 17.6,
   "end": 20.44,
   "text": "فرار کرده بود"
  },
  {
   "start": 20.6,
   "end": 21.68,
   "text": "و حالا باید به‌تنهایی"
  },
  {
   "start": 21.68,
   "end": 23.01,
   "text": "از دختر کوچیکش"
  },
  {
   "start": 23.25,
   "end": 24.31,
   "text": "مراقبت می‌کرد"
  }
 ],
