; Parsigo — Windows resources (icon, version info, DPI manifest).
;
; Compiled to a COFF object with windres and linked into the launcher, because
; zig's `cc` cannot take a .rc directly:
;   windres -i resource.rc -o resource.o
;   zig cc -target x86_64-windows-gnu -municode -Wl,--subsystem,windows \
;          ../windows/launcher.c resource.o -o Parsigo.exe
;
; build_portable.py does this automatically when windres is installed and
; silently skips it otherwise (the app then falls back to the .lnk icon).

#include <winver.h>

1 ICON "../desktop/assets/parsigo.ico"
2 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Parsigo"
            VALUE "FileDescription",  "Parsigo - Persian text to speech (offline)"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "Parsigo"
            VALUE "LegalCopyright",   "Models: CC-BY-NC-4.0 (see NOTICE.md)"
            VALUE "OriginalFilename", "Parsigo.exe"
            VALUE "ProductName",      "Parsigo"
            VALUE "ProductVersion",   "1.1.0.0"
            VALUE "Comments",         "Offline Persian TTS, ONNX Runtime, CPU only"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
