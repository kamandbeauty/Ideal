<?xml version="1.0" encoding="utf-8"?>
<!--
  Parsigo — application manifest.

  * dpiAwareness: per-monitor v2. Without it a WebView window on a scaled
    (125%/150%) display renders blurry, because Windows bitmap-stretches the
    whole client area.
  * longPathAware: users keep long Persian file names; >260 char paths would
    otherwise fail when saving a WAV deep in a folder tree.
  * UTF-8 active code page: keeps Persian text in logs/console readable on
    systems whose ANSI code page is not UTF-8.
  * supportedOS: correct Windows version reporting (taskbar/DPI behaviour).
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="Parsigo.Desktop" version="1.1.0.0" processorArchitecture="amd64"/>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/> <!-- Win 10/11 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/> <!-- Win 8.1 -->
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
