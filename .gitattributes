# Windows scripts must keep CRLF, or cmd.exe/PowerShell can misparse them
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.vbs  text eol=crlf
*.iss  text eol=crlf
*.rc   text eol=crlf

# …and the Linux/CI helpers must keep LF
*.sh   text eol=lf
*.py   text eol=lf

# binary payloads: never touch, never diff
*.ico   binary
*.png   binary
*.wav   binary
*.woff2 binary
*.mp4   binary
