{
  "name": "ideal-motion",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Illustrated-story motion studio — house style: Strasbourg dancing plague (1518)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "story:new": "node engine/new-project.mjs",
    "story:build": "node engine/build.mjs",
    "story:timeline": "node engine/timeline.mjs",
    "story:words": "node engine/words.mjs",
    "story:audio": "node engine/audio.mjs",
    "story:stills": "node engine/render.mjs --stills 8",
    "story:render": "node engine/render.mjs",
    "dance:timeline": "node motion/dance-1518/tools/timeline.mjs",
    "dance:words": "node motion/dance-1518/tools/words.mjs",
    "dance:audio": "node motion/dance-1518/audio/build.mjs",
    "dance:render": "node motion/dance-1518/render.mjs --fast",
    "dance:stills": "node motion/dance-1518/render.mjs --stills 8",
    "odd-file:audio": "node motion/odd-file/audio/build.mjs",
    "odd-file:timeline": "node motion/odd-file/audio/build.mjs",
    "odd-file:render": "node motion/odd-file/render.mjs",
    "odd-file:sample": "node motion/odd-file/render.mjs --sample",
    "odd-file:srt": "node motion/odd-file/audio/make-srt.mjs",
    "motion:new": "node .agents/skills/motion-graphics/scripts/new-motion.mjs",
    "motion:render": "node .agents/skills/motion-graphics/scripts/render.mjs",
    "motion:preview": "node scripts/preview.mjs",
    "skills:add": "skills add",
    "skills:list": "skills list",
    "skills:validate": "bash scripts/validate-skills.sh"
  },
  "devDependencies": {
    "@ffmpeg-installer/linux-x64": "^4.1.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/estedad": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@sparticuz/chromium": "^153.0.0",
    "playwright-core": "^1.64.1",
    "skills": "^1.7.4"
  }
}
