{
  "name": "ideal-motion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ideal motion-graphics workspace with Agent Skills support",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "kamand-eye:audio": "python3 motion/kamand-eye/audio/make-audio.py",
    "kamand-eye:render": "node motion/kamand-eye/render.mjs",
    "kamand-eye:sample": "node motion/kamand-eye/render.mjs --sample",
    "kamand-eye:vo:persian-tts": "python3 motion/kamand-eye/audio/generate-vo-persian-tts.py",
    "kamand-paper:audio": "python3 motion/kamand-paper/audio/make-audio.py",
    "kamand-paper:render": "node motion/kamand-paper/render.mjs",
    "kamand-paper:sample": "node motion/kamand-paper/render.mjs --sample",
    "kamand-vox:audio": ".venv/bin/python motion/kamand-vox/audio/make-audio.py",
    "kamand-vox:render": "node motion/kamand-vox/render.mjs",
    "kamand-vox:sample": "node motion/kamand-vox/render.mjs --sample",
    "kamand-vox:timeline": ".venv/bin/python motion/kamand-vox/audio/build-timeline.py",
    "kamand-vox:vo:persian-tts": ".venv/bin/python motion/kamand-vox/audio/generate-vo-persian-tts.py",
    "kamand:render": "node motion/kamand-eyebrow-gel/render.mjs",
    "kamand:render:no-text": "node motion/kamand-eyebrow-gel/render.mjs --no-text",
    "kamand:sample": "node motion/kamand-eyebrow-gel/render.mjs --sample",
    "motion:new": "node .agents/skills/motion-graphics/scripts/new-motion.mjs",
    "motion:preview": "node scripts/preview.mjs",
    "motion:render": "node .agents/skills/motion-graphics/scripts/render.mjs",
    "odd-file:audio": "node motion/odd-file/audio/build.mjs",
    "odd-file:render": "node motion/odd-file/render.mjs",
    "odd-file:sample": "node motion/odd-file/render.mjs --sample",
    "odd-file:srt": "node motion/odd-file/audio/make-srt.mjs",
    "odd-file:timeline": "node motion/odd-file/audio/build.mjs",
    "skills:add": "skills add",
    "skills:list": "skills list",
    "skills:validate": "bash scripts/validate-skills.sh"
  },
  "devDependencies": {
    "@ffmpeg-installer/linux-x64": "^4.1.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/estedad": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@sparticuz/chromium": "^153.0.0",
    "playwright-core": "^1.64.1",
    "skills": "^1.7.4"
  }
}
